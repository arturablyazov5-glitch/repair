# nginx: фрагмент для server { } сайта, корень = dist/ (npm run build:prod).
# Нужны модули: gzip_static (стандартный, --with-http_gzip_static_module) и, для brotli, ngx_brotli (brotli_static).
root /var/www/servis-lyuks/dist;
index index.html;
charset utf-8;

# Предсжатые файлы, которые кладёт build-prod.mjs (*.br, *.gz) — без сжатия на лету
gzip_static on;
brotli_static on;          # закомментировать, если ngx_brotli не установлен
# На случай файлов без предсжатия (маленькие < 512 Б) — сжатие на лету
gzip on;
gzip_comp_level 6;
gzip_min_length 512;
gzip_vary on;
gzip_types text/css application/javascript text/javascript image/svg+xml application/json application/xml text/plain;

types { image/avif avif; image/webp webp; font/woff2 woff2; }

# Хешированные ассеты: имя меняется при каждом изменении содержимого -> кеш на год
location ~* ^/(assets|media/photos-opt)/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff;
    access_log off;
    try_files $uri =404;
}

# Стабильные URL (favicon, og-image для соцсетей, apple-touch-icon)
location ^~ /media/brand/ {
    add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800";
    try_files $uri =404;
}

# HTML: всегда ревалидировать (ETag/Last-Modified), чтобы новые хеши ассетов подхватывались сразу
location / {
    add_header Cache-Control "public, max-age=0, must-revalidate";
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy strict-origin-when-cross-origin;
    try_files $uri $uri/ $uri.html =404;
}

location = /robots.txt  { add_header Cache-Control "public, max-age=3600"; }
location = /sitemap.xml { add_header Cache-Control "public, max-age=3600"; }
